{
  "name": "barrage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs dist",
    "preview": "node scripts/serve.mjs dist",
    "verify": "node --check src/game.js && node --check scripts/build.mjs && npm run build && node --check dist/src/game.js && npm run test:visual",
    "size": "node scripts/size-report.mjs",
    "map": "node scripts/game-map.mjs",
    "shot": "node scripts/capture-preview.mjs",
    "clean:tmp": "node scripts/clean-tmp.mjs",
    "pretest:visual": "npm run build",
    "test:visual": "playwright test --project=mobile-chromium",
    "pretest:visual:update": "npm run build",
    "test:visual:update": "playwright test --project=mobile-chromium --update-snapshots",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "terser": "^5.48.0"
  }
}
